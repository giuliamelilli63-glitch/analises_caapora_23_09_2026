# ============================================================
# 8. FUNÇÃO PARA REDUZIR O NOME AO NÍVEL DE ESPÉCIE
# ============================================================
#
# A função mantém somente:
#
# Gênero + epíteto específico
#
# Exemplos:
#
# Manihot esculenta Crantz
# -> Manihot esculenta
#
# Manihot esculenta var. alguma (...)
# -> Manihot esculenta
#
# Manihot esculenta subsp. alguma (...)
# -> Manihot esculenta
#
# Abelia ×grandiflora (...)
# -> Abelia ×grandiflora
#
# Abelia × grandiflora (...)
# -> Abelia ×grandiflora
#
# ============================================================

extrair_especie <- function(x) {
  
  x <- as.character(x)
  
  
  resultado <- sapply(
    
    x,
    
    function(nome) {
      
      # ------------------------------------------------------
      # Ausentes
      # ------------------------------------------------------
      
      if (
        is.na(nome) ||
          trimws(nome) == ""
      ) {
        
        return(
          NA_character_
        )
        
      }
      
      
      # ------------------------------------------------------
      # Corrigir espaços
      # ------------------------------------------------------
      
      nome <- trimws(nome)
      
      nome <- gsub(
        "\\s+",
        " ",
        nome
      )
      
      
      # ------------------------------------------------------
      # Separar palavras
      # ------------------------------------------------------
      
      partes <- strsplit(
        nome,
        "\\s+"
      )[[1]]
      
      
      # ------------------------------------------------------
      # Precisamos de pelo menos gênero + espécie
      # ------------------------------------------------------
      
      if (
        length(partes) < 2
      ) {
        
        return(
          NA_character_
        )
        
      }
      
      
      # ------------------------------------------------------
      # Híbrido com × separado
      #
      # Abelia × grandiflora
      #
      # -> Abelia ×grandiflora
      # ------------------------------------------------------
      
      if (
        length(partes) >= 3 &&
          partes[2] == "×"
      ) {
        
        return(
          paste0(
            partes[1],
            " ×",
            partes[3]
          )
        )
        
      }
      
      
      # ------------------------------------------------------
      # Nome normal ou híbrido com × junto ao epíteto
      #
      # Manihot esculenta
      #
      # Abelia ×grandiflora
      # ------------------------------------------------------
      
      return(
        paste(
          partes[1],
          partes[2]
        )
      )
      
    }
    
  )
  
  
  unname(
    resultado
  )
  
}


