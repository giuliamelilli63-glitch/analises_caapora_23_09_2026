  nrow(duplicacoes_finais),
  "\n"
)

if (nrow(duplicacoes_finais) > 0) {
  
  stop(
    "Ainda existem nomes aceitos duplicados após consolidação."
  )
}


# ============================================================
# 34. CALCULAR RIQUEZA POR INVENTÁRIO
# ============================================================

riqueza <- data.frame(
  
  ponto =
    inventarios_encontrados,
  
  riqueza =
    vapply(
      
      inventarios_encontrados,
      
      function(ponto) {
        
        sum(
          matriz_final[[ponto]] > 0,
          na.rm = TRUE
        )
      },
      
      numeric(1)
    ),
  
  stringsAsFactors = FALSE
)


# ============================================================
# 35. ADICIONAR RIQUEZA À BASE DE REFERÊNCIAS
# ============================================================

referencia_com_riqueza <- referencia %>%
  mutate(
    chave_ponto =
      ponto %>%
      as.character() %>%
      str_squish() %>%
      str_to_lower()
  ) %>%
  left_join(
    
    riqueza %>%
      mutate(
        chave_ponto =
          ponto %>%
          str_squish() %>%
          str_to_lower()
      ) %>%
      select(
        chave_ponto,
        riqueza
      ),
    
    by = "chave_ponto"
  ) %>%
  select(
    -chave_ponto
  )


