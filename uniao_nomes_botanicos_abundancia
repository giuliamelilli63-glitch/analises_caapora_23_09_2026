separar_habitos <- function(x) {
  x <- limpar(x)
  x <- x[!is.na(x)]
  if (length(x) == 0) return(character(0))
  partes <- unlist(strsplit(x, ";", fixed = TRUE))
  partes <- limpar(partes)
  sort(unique(partes[!is.na(partes)]))
}

classificar_divergencia <- function(x) {
  x <- unique(limpar(x))
  x <- x[!is.na(x)]
  if (length(x) <= 1) return("sem_divergencia")
  
  conjuntos <- lapply(x, separar_habitos)
  todos <- sort(unique(unlist(conjuntos)))
  
  # Uma descricao ja contem a uniao de todas as demais.
  if (any(vapply(conjuntos, function(h) setequal(h, todos), logical(1)))) {
    return("compativeis_por_inclusao")
  }
  
  # Pelo menos um habito compartilhado entre todas as descricoes.
  comuns <- Reduce(intersect, conjuntos)
  if (length(comuns) > 0) return("habitos_complementares")
  
  return("habitos_distintos")
}

