# ============================================================
# 2. FUNCOES AUXILIARES
# ============================================================

limpar <- function(x) {
  
  x <- as.character(x)
  
  x <- gsub("\ufeff", "", x, fixed = TRUE)
  x <- gsub("\u00a0", " ", x, fixed = TRUE)
  x <- gsub("\u200b", "", x, fixed = TRUE)
  
  x <- stringr::str_squish(x)
  
  x[x == ""] <- NA_character_
  
  x
}


chave_taxonomica <- function(x) {
  
  x <- limpar(x)
  
  x <- stringr::str_to_lower(x)
  
  x <- gsub(
    "_",
    " ",
    x,
    fixed = TRUE
  )
  
  x <- stringr::str_squish(x)
  
  x
}


normalizar_identificacao <- function(x) {
  
  x <- chave_taxonomica(x)
  
  x[x %in% c(
    "completo",
    "completas",
    "completos"
  )] <- "completa"
  
  x[x %in% c(
    "incompleto",
    "incompletas",
    "incompletos"
  )] <- "incompleta"
  
  x[x %in% c(
    "indet",
    "indet.",
    "indeterminado",
    "indeterminadas",
    "indeterminados"
  )] <- "indeterminada"
  
  x
}


primeiro <- function(x) {
  
  x <- limpar(x)
  
  x <- x[!is.na(x)]
  
  if (length(x) == 0) {
    return(NA_character_)
  }
  
  x[1]
}


juntar_unicos <- function(x) {
  
  x <- limpar(x)
  
  x <- sort(unique(x[!is.na(x)]))
  
  if (length(x) == 0) {
    return(NA_character_)
  }
  
  paste(x, collapse = "; ")
}


consolidar_habitos <- function(x) {
  
  x <- limpar(x)
  
  x <- x[!is.na(x)]
  
  if (length(x) == 0) {
    return(NA_character_)
  }
  
  partes <- unlist(
    stringr::str_split(x, ";")
  )
  
  partes <- limpar(partes)
  
  partes <- sort(unique(
    partes[!is.na(partes)]
  ))
  
  if (length(partes) == 0) {
    return(NA_character_)
  }
  
  paste(partes, collapse = "; ")
}


