# ============================================================
# 3.1 NORMALIZAR NOME PARA COMPARAÇÃO
#
# IMPORTANTE:
#
# NÃO usamos iconv ASCII//TRANSLIT.
#
# Isso evita destruir o símbolo ×.
#
# Também fazemos:
#
# Phaseolus × dumosus
# Phaseolus ×dumosus
#
# virarem:
#
# phaseolus ×dumosus
#
# SOMENTE NA CHAVE DE COMPARAÇÃO.
# ============================================================

normalizar_nome <- function(x) {
  
  x <- as.character(x)
  
  x <- gsub(
    "_",
    " ",
    x,
    fixed = TRUE
  )
  
  x <- gsub(
    "\u00A0",
    " ",
    x,
    fixed = TRUE
  )
  
  # ------------------------------------------
  # Espaço depois de × é ignorado
  # ------------------------------------------
  
  x <- gsub(
    "×[[:space:]]+",
    "×",
    x
  )
  
  # ------------------------------------------
  # espaços repetidos
  # ------------------------------------------
  
  x <- gsub(
    "[[:space:]]+",
    " ",
    x
  )
  
  x <- trimws(x)
  
  x <- tolower(x)
  
  x[
    is.na(x) |
      x == ""
  ] <- NA_character_
  
  x
}


# ============================================================
# 3.2 EXTRAIR JSON REFLORA
# ============================================================

extrair_json <- function(x, campo) {
  
  if (
    is.na(x) ||
      trimws(x) == ""
  ) {
    return(NA_character_)
  }
  
  obj <- tryCatch(
    jsonlite::fromJSON(x),
    error = function(e) NULL
  )
  
  if (
    is.null(obj) ||
      is.null(obj[[campo]])
  ) {
    return(NA_character_)
  }
  
  valores <- unique(
    as.character(
      obj[[campo]]
    )
  )
  
  valores <- valores[
    !is.na(valores) &
      trimws(valores) != ""
  ]
  
  if (length(valores) == 0) {
    return(NA_character_)
  }
  
  paste(
    valores,
    collapse = "; "
  )
}


# ============================================================
# 3.3 JUNTAR VALORES ÚNICOS
# ============================================================

juntar_unicos <- function(x) {
  
  x <- as.character(x)
  
  x <- x[
    !is.na(x) &
      trimws(x) != ""
  ]
  
  x <- unique(x)
  
  if (length(x) == 0) {
    return(NA_character_)
  }
  
  paste(
    sort(x),
    collapse = "; "
  )
}


# ============================================================
# 3.4 PREPARAR NOME BOTÂNICO
#
# Exemplos:
#
# arracacia_xanthorrhiza
# ->
# Arracacia xanthorrhiza
#
# campomanesia_xanthocarpa
# ->
# Campomanesia xanthocarpa
#
# phaseolus_×dumosus
# ->
# Phaseolus ×dumosus
#
# phaseolus_×_dumosus
# ->
# Phaseolus ×dumosus
#
# euterpe_edulis_var_edulis
# ->
# Euterpe edulis
#
# IMPORTANTE:
# a letra x NÃO é convertida em ×.
# ============================================================

preparar_nome_botanico <- function(x) {
  
  if (
    is.na(x) ||
      trimws(x) == ""
  ) {
    return(NA_character_)
  }
  
  x <- as.character(x)
  
  x <- trimws(x)
  
  
  # ------------------------------------------
  # underline -> espaço
  # ------------------------------------------
  
  x <- gsub(
    "_",
    " ",
    x,
    fixed = TRUE
  )
  
  x <- stringr::str_squish(x)
  
  
  # ------------------------------------------
  # HÍBRIDO
  #
  # Somente se já existir ×.
  #
  # × dumosus -> ×dumosus
  #
  # NÃO mexe em:
  #
  # xanthorrhiza
  # xanthocarpa
  # xerophytica
  # etc.
  # ------------------------------------------
  
  x <- gsub(
    "×[[:space:]]+",
    "×",
    x
  )
  
  
  # ------------------------------------------
  # REMOVER PARTE INFRAESPECÍFICA
  #
  # var.
  # var
  # subsp.
  # subsp
  # ssp.
  # ssp
  # subvar.
  # f.
  # forma
  #
  # A informação será guardada separadamente.
  # ------------------------------------------
  
  x <- sub(
    "\\s+(subsp\\.?|ssp\\.?|var\\.?|subvar\\.?|f\\.?|forma)\\s+.*$",
    "",
    x,
    ignore.case = TRUE
  )
  
  x <- stringr::str_squish(x)
  
  
  # ------------------------------------------
  # Primeira letra do gênero maiúscula
  # ------------------------------------------
  
  if (!is.na(x) && nchar(x) > 0) {
    
    primeira <- toupper(
      substr(
        x,
        1,
        1
      )
    )
    
    restante <- substr(
      x,
      2,
      nchar(x)
    )
    
    x <- paste0(
      primeira,
      restante
    )
  }
  
  
  if (x == "") {
    return(NA_character_)
  }
  
  x
}


# ============================================================
# 3.5 EXTRAIR INFRAESPECÍFICO
# ============================================================

extrair_infraespecifico <- function(x) {
  
  if (
    is.na(x) ||
      trimws(x) == ""
  ) {
    return(NA_character_)
  }
  
  x <- as.character(x)
  
  x <- gsub(
    "_",
    " ",
    x,
    fixed = TRUE
  )
  
  x <- stringr::str_squish(x)
  
  
  encontrado <- stringr::str_extract(
    x,
    regex(
      "\\b(subsp\\.?|ssp\\.?|var\\.?|subvar\\.?|f\\.?|forma)\\s+.*$",
      ignore_case = TRUE
    )
  )
  
  
  if (
    is.na(encontrado) ||
      trimws(encontrado) == ""
  ) {
    return(NA_character_)
  }
  
  
  trimws(
    encontrado
  )
}


# ============================================================
# 3.6 IDENTIFICAR HÍBRIDO
#
# SOMENTE ×
#
# Arracacia xanthorrhiza   = FALSE
# Campomanesia xanthocarpa = FALSE
# Phaseolus ×dumosus       = TRUE
# Phaseolus × dumosus      = TRUE
# ============================================================

identificar_hibrido <- function(x) {
  
  if (
    is.na(x) ||
      trimws(x) == ""
  ) {
    return(FALSE)
  }
  
  grepl(
    "×",
    as.character(x),
    fixed = TRUE
  )
}


# ============================================================
# 3.7 EXTRAIR LIFEFORM POWO
# ============================================================

extrair_lifeform_powo <- function(x) {
  
  x <- as.character(x)
  
  x_limpo <- gsub(
    '\\\\"',
    '"',
    x
  )
  
  x_limpo <- gsub(
    '"',
    '',
    x_limpo,
    fixed = TRUE
  )
  
  resultado <- stringr::str_match(
    x_limpo,
    "lifeform\\s*:\\s*([^,}]*)"
  )[, 2]
  
  resultado <- trimws(
    resultado
  )
  
  resultado[
    is.na(resultado) |
      resultado == ""
  ] <- NA_character_
  
  resultado
}


