  select(
    
    chave_powo,
    
    encontrado_powo,
    
    decisao_powo,
    
    taxonid_powo,
    
    nome_encontrado_powo,
    
    autoria_encontrada_powo,
    
    status_powo,
    
    taxonid_aceito_powo,
    
    nome_aceito_powo,
    
    autoria_aceita_powo,
    
    familia_aceita_powo,
    
    genero_aceito_powo,
    
    rank_aceito_powo,
    
    status_nome_aceito_powo,
    
    lifeform_aceito_powo
  )


