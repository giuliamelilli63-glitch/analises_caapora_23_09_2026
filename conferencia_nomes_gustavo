# ============================================================
# 22. FUNÇÃO PARA EXTRAIR REFLORA
# ============================================================

extrair_reflora <- function(coluna) {
  
  resultado <-
    rep(
      NA,
      nrow(especies)
    )
  
  indices <- which(
    especies$conferencia_reflora
  )
  
  resultado[
    indices
  ] <-
    coluna[
      posicao_reflora[
        indices
      ]
    ]
  
  resultado
}


