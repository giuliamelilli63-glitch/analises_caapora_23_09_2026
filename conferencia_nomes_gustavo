montar_nome_sem_autoria <- function(
    genus,
  especie,
  infra
) {
  
  partes <- c(
    genus,
    especie,
    infra
  )
  
  partes <- partes[
    !is.na(partes) &
      trimws(partes) != ""
  ]
  
  if (length(partes) == 0) {
    return(NA_character_)
  }
  
  paste(
    partes,
    collapse = " "
  )
}


