especies <- especies %>%
  
  mutate(
    
    base_conferencia =
      case_when(
        
        conferencia_reflora ~
          "REFLORA",
        
        !is.na(
          decisao_powo
        ) &
          decisao_powo %in%
          c(
            "ACCEPTED",
            "SYNONYM"
          ) ~
          "POWO",
        
        TRUE ~
          NA_character_
      ),
    
    
    status_conferencia =
      case_when(
        
        conferencia_reflora ~
          "CONFERIDO_REFLORA",
        
        empate_powo ~
          "EMPATE_POWO_REVISAR",
        
        decisao_powo ==
          "ACCEPTED" ~
          "CONFERIDO_POWO",
        
        decisao_powo ==
          "SYNONYM" ~
          "CONFERIDO_POWO_SINONIMO",
        
        decisao_powo ==
          "REVISAR_STATUS" ~
          "REVISAR_STATUS_POWO",
        
        TRUE ~
          "NAO_ENCONTRADO"
      ),
    
    
    nome_aceito_final =
      case_when(
        
        conferencia_reflora ~
          nome_aceito_reflora,
        
        base_conferencia ==
          "POWO" ~
          ifelse(
            is.na(autoria_aceita_powo) |
              autoria_aceita_powo == "",
            nome_aceito_powo,
            paste(
              nome_aceito_powo,
              autoria_aceita_powo
            )
          ),
        
        TRUE ~
          NA_character_
      ),
    
    
    familia_final =
      case_when(
        
        conferencia_reflora ~
          familia_reflora,
        
        base_conferencia ==
          "POWO" ~
          familia_aceita_powo,
        
        TRUE ~
          NA_character_
      ),
    
    
    genero_final =
      case_when(
        
        conferencia_reflora ~
          genero_reflora,
        
        base_conferencia ==
          "POWO" ~
          genero_aceito_powo,
        
        TRUE ~
          NA_character_
      ),
    
    
    nivel_taxonomico_final =
      case_when(
        
        conferencia_reflora ~
          nivel_taxonomico_reflora,
        
        base_conferencia ==
          "POWO" ~
          rank_aceito_powo,
        
        TRUE ~
          NA_character_
      ),
    
    
    lifeForm_final =
      case_when(
        
        conferencia_reflora ~
          lifeForm_reflora,
        
        base_conferencia ==
          "POWO" ~
          lifeform_aceito_powo,
        
        TRUE ~
          NA_character_
      )
  )


