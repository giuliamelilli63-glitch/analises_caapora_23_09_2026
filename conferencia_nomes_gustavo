# ============================================================
# 30. NOMES QUE NÃO FORAM ENCONTRADOS NO REFLORA
# ============================================================

busca_powo <- especies %>%
  
  filter(
    !conferencia_reflora,
    !is.na(
      chave_busca
    )
  ) %>%
  
  distinct(
    chave_busca,
    .keep_all = TRUE
  ) %>%
  
  transmute(
    chave_powo =
      chave_busca
  )


cat(
  "Nomes enviados ao POWO:",
  nrow(busca_powo),
  "\n"
)


# ============================================================
# 31. CORRESPONDÊNCIAS POWO
# ============================================================

correspondencias_powo <- busca_powo %>%
  
  left_join(
    
    wcvp %>%
      
      select(
        
        chave_powo,
        
        taxonid_powo =
          taxonid,
        
        nome_encontrado_powo =
          nome_cientifico_wcvp,
        
        autoria_encontrada_powo =
          autoria_wcvp,
        
        status_powo =
          taxonomicstatus,
        
        acceptednameusageid,
        
        lifeform_nome_encontrado_powo =
          lifeform_powo
      ),
    
    by =
      "chave_powo",
    
    relationship =
      "many-to-many"
  ) %>%
  
  mutate(
    
    encontrado_powo =
      !is.na(
        taxonid_powo
      ),
    
    prioridade_powo =
      case_when(
        
        status_powo %in%
          c(
            "Accepted",
            "Provisionally Accepted"
          ) ~
          1L,
        
        status_powo ==
          "Synonym" ~
          2L,
        
        encontrado_powo ~
          3L,
        
        TRUE ~
          4L
      )
  )


# ============================================================
# 32. MELHOR PRIORIDADE POWO
# ============================================================

melhor_powo <- correspondencias_powo %>%
  
  group_by(
    chave_powo
  ) %>%
  
  mutate(
    
    melhor_prioridade =
      min(
        prioridade_powo,
        na.rm = TRUE
      )
  ) %>%
  
  filter(
    prioridade_powo ==
      melhor_prioridade
  ) %>%
  
  ungroup()


# ============================================================
# 33. IDENTIFICAR EMPATES REAIS
# ============================================================

empates_powo <- melhor_powo %>%
  
  filter(
    encontrado_powo
  ) %>%
  
  group_by(
    chave_powo
  ) %>%
  
  summarise(
    
    n_taxons =
      n_distinct(
        taxonid_powo
      ),
    
    .groups =
      "drop"
  ) %>%
  
  filter(
    n_taxons > 1
  )


chaves_empate <-
  empates_powo$chave_powo


# ============================================================
# 34. RESULTADOS SEM EMPATE
# ============================================================

selecionados_powo <- melhor_powo %>%
  
  filter(
    !chave_powo %in%
      chaves_empate
  ) %>%
  
  group_by(
    chave_powo
  ) %>%
  
  slice(1) %>%
  
  ungroup() %>%
  
  mutate(
    
    decisao_powo =
      case_when(
        
        !encontrado_powo ~
          "NAO_ENCONTRADO",
        
        prioridade_powo ==
          1 ~
          "ACCEPTED",
        
        prioridade_powo ==
          2 ~
          "SYNONYM",
        
        TRUE ~
          "REVISAR_STATUS"
      ),
    
    
    taxonid_aceito_powo =
      case_when(
        
        decisao_powo ==
          "ACCEPTED" ~
          taxonid_powo,
        
        decisao_powo ==
          "SYNONYM" ~
          acceptednameusageid,
        
        TRUE ~
          NA_character_
      )
  )


# ============================================================
# 35. RECUPERAR NOME ACEITO POWO
# ============================================================

