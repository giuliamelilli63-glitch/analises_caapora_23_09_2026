)


# ============================================================
# 2. LER BASE FINAL
# ============================================================

dados <- read_excel(
  arquivo_entrada,
  sheet = "Base_final"
)

dados <- as.data.frame(
  dados,
  stringsAsFactors = FALSE,
  check.names = FALSE
)


cat(
  "\nNúmero de registros na entrada:",
  nrow(dados),
  "\n"
)


# ============================================================
# 3. FUNÇÃO PARA RETIRAR AUTORIA E INFRAESPÉCIE
#
# IMPORTANTE:
# Esta função será aplicada SOMENTE às identificações
# completas.
#
# Mantém apenas:
#
# Gênero + epíteto específico
#
# Exemplos:
#
# Adenocalymma acutissimum
# -> Adenocalymma acutissimum
#
# Schinus terebinthifolius Raddi
# -> Schinus terebinthifolius
#
# Lantana nivea subsp. nivea
# -> Lantana nivea
#
# Roupala montana var. brasiliensis
# -> Roupala montana
#
# ============================================================

reduzir_para_especie <- function(x) {

  x <- as.character(x)

  resultado <- rep(
    NA_character_,
    length(x)
  )

  valido <-
    !is.na(x) &
    trimws(x) != ""

  x_limpo <- str_squish(
    x[valido]
  )

  partes <- str_split(
    x_limpo,
    "\\s+"
  )

  resultado[valido] <- vapply(
    partes,
    function(p) {

      if (length(p) >= 2) {

        paste(
          p[1],
          p[2]
        )

      } else {

        p[1]

      }
    },
    FUN.VALUE = character(1)
  )

  resultado
}


# ============================================================
# 4. PADRONIZAR IDENTIFICAÇÃO
# ============================================================

dados <- dados %>%

  mutate(

    identificacao_final =
      identificacao %>%
      as.character() %>%
      str_squish() %>%
      str_to_lower()

  )


# ============================================================
# 5. CRIAR NOME ACEITO SIMPLIFICADO
#
# COMPLETA:
# gênero + espécie
#
# INCOMPLETA:
# mantém o gênero final
#
# INDETERMINADA:
# NA
# ============================================================

dados <- dados %>%

  mutate(

    nome_aceito_simplificado =
      case_when(

        identificacao_final == "completa" ~
          reduzir_para_especie(
            nome_final
          ),

        identificacao_final == "incompleta" &
          !is.na(genero_final) ~
          genero_final,

        TRUE ~
          NA_character_

      )

  )


# ============================================================
# 6. IDENTIFICAR EM QUAL MATRIZ O NOME ESTÁ PRESENTE
#
# ocorrência = ocorrencia == 1
# abundância = abundancia == 1
#
# Se estiver nas duas:
# "ocorrencia; abundancia"
# ============================================================

dados <- dados %>%

  mutate(

    matriz =
      case_when(

        ocorrencia == 1 &
          abundancia == 1 ~
          "ocorrencia; abundancia",

        ocorrencia == 1 ~
          "ocorrencia",

        abundancia == 1 ~
          "abundancia",

        TRUE ~
          NA_character_

      )

  )


# ============================================================
# 7. MONTAR TABELA FINAL
# ============================================================

tabela_final <- dados %>%

  transmute(

    especie_referencia =
      especie,

    nome_aceito =
      nome_aceito_simplificado,

    identificacao =
      identificacao_final,

    familia =
      familia_final,

    genero =
      genero_final,

    matriz =
      matriz,

    habito =
      lifeForm_padronizado

  )


