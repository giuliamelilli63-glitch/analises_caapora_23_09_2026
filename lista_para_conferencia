# ============================================================
# 0. PACOTES
# ============================================================

pacotes <- c(
  "readxl",
  "dplyr",
  "stringr",
  "openxlsx"
)

pacotes_faltantes <- pacotes[
  !pacotes %in% rownames(installed.packages())
]

if (length(pacotes_faltantes) > 0) {
  install.packages(pacotes_faltantes)
}

library(readxl)
library(dplyr)
library(stringr)
library(openxlsx)


# ============================================================
# 1. CAMINHOS
# ============================================================

pasta_caapora <-
  "C:/Users/giuli/OneDrive/Documentos/Caapora"

pasta_taxonomia <- file.path(
  pasta_caapora,
  "taxonomia"
)


arquivo_entrada <- file.path(
  pasta_taxonomia,
  "conferencia_final_reflora_powo.xlsx"
)


arquivo_saida <- file.path(
  pasta_taxonomia,
