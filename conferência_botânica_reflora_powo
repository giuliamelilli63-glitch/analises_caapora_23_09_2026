# ------------------------------------------------------------
# NORMALIZAR NOME SOMENTE PARA COMPARAÇÃO
# ------------------------------------------------------------

normalizar_nome <- function(x) {
  
  x <- as.character(x)
  
  x <- iconv(
    x,
    from = "",
    to = "ASCII//TRANSLIT",
    sub = ""
  )
  
  x <- tolower(x)
  
  x <- gsub(
    "_",
    " ",
    x,
    fixed = TRUE
  )
  
  x <- gsub(
    "\u00A0",
    " ",
    x,
    fixed = TRUE
  )
  
  x <- gsub(
    "[[:space:]]+",
    " ",
    x
  )
  
  x <- trimws(x)
  
  x[
    is.na(x) |
      x == ""
  ] <- NA_character_
  
  x
}


# ------------------------------------------------------------
# EXTRAIR JSON DO REFLORA
# ------------------------------------------------------------

extrair_json <- function(x, campo) {
  
  if (
    is.na(x) ||
      trimws(x) == ""
  ) {
    return(NA_character_)
  }
  
  obj <- tryCatch(
    jsonlite::fromJSON(x),
    error = function(e) NULL
  )
  
  if (
    is.null(obj) ||
      is.null(obj[[campo]])
  ) {
    return(NA_character_)
  }
  
  valores <- unique(
    as.character(
      obj[[campo]]
    )
  )
  
  valores <- valores[
    !is.na(valores) &
      trimws(valores) != ""
  ]
  
  if (length(valores) == 0) {
    return(NA_character_)
  }
  
  paste(
    valores,
    collapse = "; "
  )
}


# ------------------------------------------------------------
# JUNTAR VALORES ÚNICOS
# ------------------------------------------------------------

juntar_unicos <- function(x) {
  
  x <- as.character(x)
  
  x <- x[
    !is.na(x) &
      trimws(x) != ""
  ]
  
  x <- unique(x)
  
  if (length(x) == 0) {
    return(NA_character_)
  }
  
  paste(
    sort(x),
    collapse = "; "
  )
}


# ------------------------------------------------------------
# PRIMEIRO VALOR VÁLIDO
# ------------------------------------------------------------

primeiro_valido <- function(x) {
  
  x <- as.character(x)
  
  x <- x[
    !is.na(x) &
      trimws(x) != ""
  ]
  
  if (length(x) == 0) {
    return(NA_character_)
  }
  
  x[1]
}


# ------------------------------------------------------------
# EXTRAIR LIFEFORM DO POWO
# ------------------------------------------------------------

extrair_lifeform_powo <- function(x) {
  
  x <- as.character(x)
  
  x_limpo <- gsub(
    '\\\\"',
    '"',
    x
  )
  
  x_limpo <- gsub(
    '"',
    '',
    x_limpo,
    fixed = TRUE
  )
  
  resultado <- stringr::str_match(
    x_limpo,
    "lifeform\\s*:\\s*([^,}]*)"
  )[, 2]
  
  resultado <- trimws(resultado)
  
  resultado[
    is.na(resultado) |
      resultado == ""
  ] <- NA_character_
  
  resultado
}


# ============================================================
