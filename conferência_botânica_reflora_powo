    ]
  ]


especies$familia_genero_powo[
  indices_genero_powo_ok
] <-
  
  generos_powo$familia_genero_powo[
    posicao_genero_powo[
      indices_genero_powo_ok
    ]
  ]


# ============================================================
# 33. DEFINIR TAXONOMIA FINAL
# ============================================================

especies <- especies %>%
  
  mutate(
    
    nome_final =
      case_when(
        
        eh_completa &
          conferencia_reflora ~
          nome_aceito_reflora,
        
        eh_completa &
          !conferencia_reflora &
          decisao_powo %in%
          c(
            "ACCEPTED",
            "SYNONYM"
          ) ~
          nome_aceito_powo,
        
        eh_incompleta &
          genero_validado_reflora %in%
          TRUE ~
          genero_encontrado_reflora_incompleta,
        
        eh_incompleta &
          genero_validado_reflora %in%
          FALSE &
          genero_validado_powo %in%
          TRUE ~
          genero_encontrado_powo_incompleta,
        
        TRUE ~
          NA_character_
      ),
    
    
    familia_final =
      case_when(
        
        eh_completa &
          conferencia_reflora ~
          familia_reflora,
        
        eh_completa &
          !conferencia_reflora &
          decisao_powo %in%
          c(
            "ACCEPTED",
            "SYNONYM"
          ) ~
          familia_aceita_powo,
        
        eh_incompleta &
          genero_validado_reflora %in%
          TRUE ~
          familia_genero_reflora,
        
        eh_incompleta &
          genero_validado_reflora %in%
          FALSE &
          genero_validado_powo %in%
          TRUE ~
          familia_genero_powo,
        
        TRUE ~
          NA_character_
      ),
    
    
    genero_final =
      case_when(
        
        eh_completa &
          conferencia_reflora ~
          genero_reflora,
        
        eh_completa &
          !conferencia_reflora &
          decisao_powo %in%
          c(
            "ACCEPTED",
            "SYNONYM"
          ) ~
          genero_aceito_powo,
        
        eh_incompleta &
          genero_validado_reflora %in%
          TRUE ~
          genero_encontrado_reflora_incompleta,
        
        eh_incompleta &
          genero_validado_reflora %in%
          FALSE &
          genero_validado_powo %in%
          TRUE ~
          genero_encontrado_powo_incompleta,
        
        TRUE ~
          NA_character_
      ),
    
    
    fonte_taxonomia =
      case_when(
        
        eh_completa &
          conferencia_reflora ~
          "REFLORA",
        
        eh_completa &
          !conferencia_reflora &
          decisao_powo %in%
          c(
            "ACCEPTED",
            "SYNONYM"
          ) ~
          "POWO",
        
        eh_incompleta &
          genero_validado_reflora %in%
          TRUE ~
          "REFLORA_GENERO",
        
        eh_incompleta &
          genero_validado_reflora %in%
          FALSE &
          genero_validado_powo %in%
          TRUE ~
          "POWO_GENERO",
        
        eh_indeterminada ~
          "INDETERMINADA",
        
        TRUE ~
          "NAO_RESOLVIDA"
      )
  )


# ============================================================
# 34. DEFINIR LIFEFORM FINAL ORIGINAL
#
# Esta coluna NÃO é traduzida.
#
# Ela registra exatamente a informação utilizada:
#
# REFLORA
# ou
# POWO
# ============================================================

especies <- especies %>%
  
  mutate(
    
    lifeForm_final =
      case_when(
        
        # REFLORA possui LifeForm
        eh_completa &
          conferencia_reflora &
          !is.na(
            lifeForm_reflora
          ) &
          trimws(
            lifeForm_reflora
          ) != "" ~
          lifeForm_reflora,
        
        
        # REFLORA sem LifeForm:
        # complemento POWO
        eh_completa &
          conferencia_reflora &
          (
            is.na(
              lifeForm_reflora
            ) |
              trimws(
                lifeForm_reflora
              ) == ""
          ) &
          !is.na(
            lifeform_complemento_powo
          ) ~
          lifeform_complemento_powo,
        
        
        # espécie resolvida diretamente pelo POWO
        eh_completa &
          !conferencia_reflora &
          decisao_powo %in%
          c(
            "ACCEPTED",
            "SYNONYM"
          ) ~
          lifeform_final_powo,
        
        
        TRUE ~
          NA_character_
      ),
    
    
    fonte_lifeForm =
      case_when(
        
        eh_completa &
          conferencia_reflora &
          !is.na(
            lifeForm_reflora
          ) &
          trimws(
            lifeForm_reflora
          ) != "" ~
          "REFLORA",
        
        
        eh_completa &
          conferencia_reflora &
          (
            is.na(
              lifeForm_reflora
            ) |
              trimws(
                lifeForm_reflora
              ) == ""
          ) &
          !is.na(
            lifeform_complemento_powo
          ) ~
          "POWO_COMPLEMENTO_REFLORA",
        
        
        eh_completa &
          !conferencia_reflora &
          decisao_powo %in%
          c(
            "ACCEPTED",
            "SYNONYM"
          ) &
          !is.na(
            lifeform_final_powo
          ) ~
          "POWO",
        
        
        eh_incompleta ~
          "NAO_ATRIBUIDO_IDENTIFICACAO_INCOMPLETA",
        
        
        eh_indeterminada ~
          "NAO_ATRIBUIDO_INDETERMINADA",
        
        
        TRUE ~
          "SEM_LIFEFORM"
      )
  )


# ============================================================
# 35. PADRONIZAR LIFEFORM
#
# NOVA COLUNA:
# lifeForm_padronizado
#
# O valor original permanece em:
# lifeForm_final
# ============================================================

especies$lifeForm_padronizado <-
  vapply(
    
    especies$lifeForm_final,
    
    padronizar_lifeform,
    
    FUN.VALUE =
      character(1)
  )


# ============================================================
# 36. IDENTIFICAR LIFEFORMS QUE NÃO FORAM TRADUZIDOS
#
# Se o valor original estiver em inglês e a função
# não o reconhecer, lifeForm_padronizado será igual
# ao original.
#
# Isso permite detectar qualquer categoria nova.
# ============================================================

especies$lifeForm_requer_revisao <-
  case_when(
    
    is.na(
      especies$lifeForm_final
    ) ~
      FALSE,
    
    especies$lifeForm_final ==
      especies$lifeForm_padronizado &
      especies$fonte_lifeForm %in%
      c(
        "POWO",
        "POWO_COMPLEMENTO_REFLORA"
      ) ~
      TRUE,
    
    TRUE ~
      FALSE
  )


# ============================================================
# 37. STATUS FINAL
# ============================================================

especies <- especies %>%
  
  mutate(
    
    status_final =
      case_when(
        
        eh_completa &
          conferencia_reflora ~
          "COMPLETA_RESOLVIDA_REFLORA",
        
        eh_completa &
          !conferencia_reflora &
          decisao_powo ==
          "ACCEPTED" ~
          "COMPLETA_RESOLVIDA_POWO_ACCEPTED",
        
        eh_completa &
          !conferencia_reflora &
          decisao_powo ==
          "SYNONYM" ~
          "COMPLETA_RESOLVIDA_POWO_SYNONYM",
        
        eh_completa &
          !conferencia_reflora &
          decisao_powo ==
          "NAO_ENCONTRADO" ~
          "COMPLETA_NAO_ENCONTRADA",
        
        eh_completa &
          !conferencia_reflora &
          decisao_powo ==
          "REVISAR_STATUS" ~
          "COMPLETA_REVISAR_POWO",
        
        eh_completa &
          !conferencia_reflora &
          is.na(
            decisao_powo
          ) ~
          "COMPLETA_REVISAR_EMPATE_POWO",
        
        eh_incompleta &
          genero_validado_reflora %in%
          TRUE ~
          "INCOMPLETA_GENERO_REFLORA",
        
        eh_incompleta &
          genero_validado_reflora %in%
          FALSE &
          genero_validado_powo %in%
          TRUE ~
          "INCOMPLETA_GENERO_POWO",
        
        eh_incompleta &
          genero_validado_reflora %in%
          FALSE &
          genero_validado_powo %in%
          FALSE ~
          "INCOMPLETA_GENERO_NAO_ENCONTRADO",
        
        eh_indeterminada ~
          "INDETERMINADA",
        
        TRUE ~
          "REVISAR"
      )
  )


