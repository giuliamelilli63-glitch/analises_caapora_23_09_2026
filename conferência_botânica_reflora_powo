    # Conforme decisão adotada para esta base,
    # essas categorias são convertidas para Erva.
    # ========================================================
    
    "annual" =
      "Erva",
    
    "biennial" =
      "Erva",
    
    "perennial" =
      "Erva",
    
    "annual or biennial" =
      "Erva",
    
    "annual herb" =
      "Erva",
    
