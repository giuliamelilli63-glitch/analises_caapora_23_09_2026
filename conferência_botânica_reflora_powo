# ============================================================
# 27. FUNÇÃO GERAL DE BUSCA NO POWO
#
# PRIORIDADE:
# 1. Accepted / Provisionally Accepted
# 2. Synonym
# 3. outros status
#
# Sinônimo:
# segue acceptednameusageid
#
# Empates na melhor prioridade:
# NÃO resolve automaticamente
# ============================================================

buscar_powo <- function(
    tabela_busca
) {
  
  correspondencias <- tabela_busca %>%
    
    left_join(
      
      wcvp %>%
        
        select(
          
          chave_powo,
          
          taxonid_powo =
            taxonid,
          
          nome_encontrado_powo =
            nome_cientifico_wcvp,
          
          autoria_encontrada_powo =
            autoria_wcvp,
          
          familia_nome_encontrado_powo =
            family,
          
          genero_nome_encontrado_powo =
            genus,
          
          rank_nome_encontrado_powo =
            taxonrank,
          
          status_powo =
            taxonomicstatus,
          
          acceptednameusageid,
          
          lifeform_nome_encontrado_powo =
            lifeform_powo,
          
          referencia_powo =
            references
        ),
      
      by =
        "chave_powo",
      
      relationship =
        "many-to-many"
    ) %>%
    
    mutate(
      
      encontrado_powo =
        !is.na(
          taxonid_powo
        ),
      
      prioridade_powo =
        case_when(
          
          status_powo ==
            "Accepted" ~ 1L,
          
          status_powo ==
            "Provisionally Accepted" ~ 1L,
          
          status_powo ==
            "Synonym" ~ 2L,
          
          encontrado_powo ~
            3L,
          
          TRUE ~
            4L
        )
    )
  
  
  # ----------------------------------------------------------
  # MELHOR PRIORIDADE
  # ----------------------------------------------------------
  
  melhor <- correspondencias %>%
    
    group_by(
      chave_powo
    ) %>%
    
    mutate(
      
      melhor_prioridade =
        min(
          prioridade_powo,
          na.rm = TRUE
        )
    ) %>%
    
    filter(
      prioridade_powo ==
        melhor_prioridade
    ) %>%
    
    ungroup()
  
  
  # ----------------------------------------------------------
  # EMPATES
  # ----------------------------------------------------------
  
  empates <- melhor %>%
    
    filter(
      encontrado_powo
    ) %>%
    
    count(
      chave_powo,
      prioridade_powo,
      name =
        "n_melhor_prioridade"
    ) %>%
    
    filter(
      n_melhor_prioridade >
        1
    )
  
  
  chaves_empate <-
    empates$chave_powo
  
  
  # ----------------------------------------------------------
  # SELECIONADOS
  # ----------------------------------------------------------
  
  selecionados <- melhor %>%
    
    filter(
      !chave_powo %in%
        chaves_empate
    ) %>%
    
    group_by(
      chave_powo
    ) %>%
    
    slice(1) %>%
    
    ungroup() %>%
    
    mutate(
      
      decisao_powo =
        case_when(
          
          !encontrado_powo ~
            "NAO_ENCONTRADO",
          
          prioridade_powo ==
            1 ~
            "ACCEPTED",
          
          prioridade_powo ==
            2 ~
            "SYNONYM",
          
          TRUE ~
            "REVISAR_STATUS"
        ),
      
      taxonid_aceito_powo =
        case_when(
          
          decisao_powo ==
            "ACCEPTED" ~
            taxonid_powo,
          
          decisao_powo ==
            "SYNONYM" ~
            acceptednameusageid,
          
          TRUE ~
            NA_character_
        )
    )
  
  
  # ----------------------------------------------------------
  # RECUPERAR TÁXON ACEITO
  # ----------------------------------------------------------
  
  selecionados <- selecionados %>%
    
    left_join(
      wcvp_aceitos,
      by =
        "taxonid_aceito_powo"
    ) %>%
    
    mutate(
      
      lifeform_final_powo =
        case_when(
          
          !is.na(
            lifeform_aceito_powo
          ) &
            trimws(
              lifeform_aceito_powo
            ) != "" ~
            lifeform_aceito_powo,
          
          !is.na(
            lifeform_nome_encontrado_powo
          ) &
            trimws(
              lifeform_nome_encontrado_powo
            ) != "" ~
            lifeform_nome_encontrado_powo,
          
          TRUE ~
            NA_character_
        ),
      
      origem_lifeform_powo =
        case_when(
          
          !is.na(
            lifeform_aceito_powo
          ) &
            trimws(
              lifeform_aceito_powo
            ) != "" ~
            "TAXON_ACEITO_POWO",
          
          !is.na(
            lifeform_nome_encontrado_powo
          ) &
            trimws(
              lifeform_nome_encontrado_powo
            ) != "" ~
            "NOME_ENCONTRADO_POWO",
          
          TRUE ~
            "SEM_LIFEFORM_POWO"
        )
    )
  
  
  # ----------------------------------------------------------
  # OPÇÕES DOS EMPATES
  # ----------------------------------------------------------
  
  opcoes_empates <- correspondencias %>%
    
    filter(
      chave_powo %in%
        chaves_empate
    ) %>%
    
    arrange(
      chave_powo,
      prioridade_powo
    )
  
  
  list(
    
    correspondencias =
      correspondencias,
    
    selecionados =
      selecionados,
    
    empates =
      empates,
    
    opcoes_empates =
      opcoes_empates
  )
}


