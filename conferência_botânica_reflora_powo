# ============================================================

padronizar_lifeform <- function(x) {
  
  if (
    is.na(x) ||
      trimws(x) == ""
  ) {
    return(NA_character_)
  }
  
  original <- trimws(
    as.character(x)
  )
  
  chave <- normalizar_nome(
    original
  )
  
  
  # ----------------------------------------------------------
  # DICIONÁRIO DE PADRONIZAÇÃO
  # ----------------------------------------------------------
  
  mapa <- c(
    
    # ========================================================
    # CATEGORIAS SIMPLES REFLORA
    # ========================================================
    
    "arvore" =
      "Árvore",
    
    "arbusto" =
      "Arbusto",
    
    "subarbusto" =
      "Subarbusto",
    
    "erva" =
      "Erva",
    
    "palmeira" =
      "Palmeira",
    
    "bambu" =
      "Bambu",
    
    "suculenta" =
      "Suculenta",
    
    "dracenoide" =
      "Dracenóide",
    
    "tapete" =
      "Tapete",
    
    "tufo" =
      "Tufo",
    
    "desconhecida" =
      "Desconhecida",
    
    "liana/voluvel/trepadeira" =
      "Liana/volúvel/trepadeira",
    
    "liana" =
      "Liana/volúvel/trepadeira",
    
    "voluvel" =
      "Liana/volúvel/trepadeira",
    
    "trepadeira" =
      "Liana/volúvel/trepadeira",
    
    
    # ========================================================
    # POWO - CATEGORIAS SIMPLES
    # ========================================================
    
    "tree" =
      "Árvore",
    
    "shrub" =
      "Arbusto",
    
    "subshrub" =
      "Subarbusto",
    
    "herb" =
      "Erva",
    
    "palm" =
      "Palmeira",
    
    "climber" =
      "Liana/volúvel/trepadeira",
    
    
    # ========================================================
    # ÁRVORE / ARBUSTO
    # ========================================================
    
    "shrub or tree" =
      "Arbusto; Árvore",
    
    "tree or shrub" =
      "Arbusto; Árvore",
    
    "lignotuber shrub or tree" =
      "Arbusto; Árvore",
    
    
    # ========================================================
    # ARBUSTO / SUBARBUSTO
    # ========================================================
    
    "subshrub or shrub" =
      "Arbusto; Subarbusto",
    
    "shrub or subshrub" =
      "Arbusto; Subarbusto",
    
    
    # ========================================================
    # ERVA / ARBUSTO
    # ========================================================
    
    "herb or shrub" =
      "Arbusto; Erva",
    
    "shrub or herb" =
      "Arbusto; Erva",
    
    "perennial or shrub" =
      "Arbusto; Erva",
    
    
    # ========================================================
    # ERVA / SUBARBUSTO
    # ========================================================
    
    "herb or subshrub" =
      "Erva; Subarbusto",
    
    "subshrub or herb" =
      "Erva; Subarbusto",
    
    
    # ========================================================
    # TREPADEIRAS / LIANAS
    # ========================================================
    
    "climbing shrub or liana" =
      "Arbusto; Liana/volúvel/trepadeira",
    
    "liana or climbing shrub" =
      "Arbusto; Liana/volúvel/trepadeira",
    
    "shrub or liana" =
      "Arbusto; Liana/volúvel/trepadeira",
    
    "liana or shrub" =
      "Arbusto; Liana/volúvel/trepadeira",
    
    "climbing shrub" =
      "Arbusto; Liana/volúvel/trepadeira",
    
    "scrambling shrub" =
      "Arbusto; Liana/volúvel/trepadeira",
    
    "climbing subshrub" =
      "Liana/volúvel/trepadeira; Subarbusto",
    
    "climbing herb" =
      "Erva; Liana/volúvel/trepadeira",
    
    "herbaceous climber" =
      "Erva; Liana/volúvel/trepadeira",
    
    "climbing annual" =
      "Erva; Liana/volúvel/trepadeira",
    
    "annual climber" =
      "Erva; Liana/volúvel/trepadeira",
    
    
    # ========================================================
    # SCRAMBLING
    # ========================================================
    
    "scrambling shrub or tree" =
      "Arbusto; Árvore; Liana/volúvel/trepadeira",
    
    "scrambling tree or shrub" =
      "Arbusto; Árvore; Liana/volúvel/trepadeira",
    
    "scrambling tree" =
      "Árvore; Liana/volúvel/trepadeira",
    
    
    # ========================================================
