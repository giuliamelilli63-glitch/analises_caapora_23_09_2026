  if (chave %in% names(mapa)) {
    
    return(
      unname(
        mapa[chave]
      )
    )
  }
  
  
  # ----------------------------------------------------------
  # 2. COMBINAÇÕES JÁ EXISTENTES DO REFLORA
  #
  # Exemplo:
  # "Arbusto; Árvore; Subarbusto"
  #
  # Padronizamos cada componente individualmente.
  # ----------------------------------------------------------
  
  if (grepl(";", original, fixed = TRUE)) {
    
    partes <- unlist(
      strsplit(
        original,
        ";",
        fixed = TRUE
      )
    )
    
    partes <- trimws(partes)
    
    
    partes_padronizadas <- vapply(
      
      partes,
      
      function(parte) {
        
        chave_parte <-
          normalizar_nome(parte)
        
        if (
          chave_parte %in%
            names(mapa)
        ) {
          
          return(
            unname(
              mapa[chave_parte]
            )
          )
        }
        
        return(parte)
      },
      
      FUN.VALUE =
        character(1)
    )
    
    
    partes_padronizadas <-
      unique(
        partes_padronizadas
      )
    
    
    return(
      paste(
        partes_padronizadas,
        collapse = "; "
      )
    )
  }
  
  
  # ----------------------------------------------------------
  # 3. CATEGORIA NÃO RECONHECIDA
  #
  # Mantemos original para aparecer na revisão.
  # ----------------------------------------------------------
  
  return(original)
}


