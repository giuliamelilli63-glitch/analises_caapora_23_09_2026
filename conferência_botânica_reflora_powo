      primeiro_valido(
        family
      ),
    
    n_registros_genero_powo =
      n(),
    
    .groups = "drop"
  )


especies$genero_validado_powo <-
  NA

especies$genero_encontrado_powo_incompleta <-
  NA_character_

especies$familia_genero_powo <-
  NA_character_


indices_incompletas_powo <- which(
  
  especies$eh_incompleta &
    
    especies$genero_validado_reflora %in%
    FALSE
)


posicao_genero_powo <- match(
  
  especies$genero_informado,
  
  generos_powo$genero_busca_powo
)


especies$genero_validado_powo[
  indices_incompletas_powo
] <-
  
  !is.na(
    posicao_genero_powo[
      indices_incompletas_powo
    ]
  )


indices_genero_powo_ok <- which(
  
  especies$eh_incompleta &
    
    especies$genero_validado_reflora %in%
    FALSE &
    
    especies$genero_validado_powo %in%
    TRUE
)


especies$genero_encontrado_powo_incompleta[
  indices_genero_powo_ok
] <-
  
  generos_powo$genero_encontrado_powo_incompleta[
