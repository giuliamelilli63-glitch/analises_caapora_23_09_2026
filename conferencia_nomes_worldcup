# ============================================================
# 3.1 NORMALIZAR NOME PARA COMPARAÇÃO
#
# IMPORTANTE:
# NÃO remove variedade/subespécie.
# NÃO transforma x normal em ×.
#
# Apenas:
# - "_" -> espaço
# - remove espaços extras
# - × nome -> ×nome
# - minúsculas
# ============================================================

normalizar_nome <- function(x) {
  
  x <- as.character(x)
  
  x <- gsub(
    "_",
    " ",
    x,
    fixed = TRUE
  )
  
  x <- gsub(
    "\u00A0",
    " ",
    x,
    fixed = TRUE
  )
  
  # × dumosus -> ×dumosus
  x <- gsub(
    "×[[:space:]]+",
    "×",
    x
  )
  
  x <- gsub(
    "[[:space:]]+",
    " ",
    x
  )
  
  x <- trimws(x)
  
  x <- tolower(x)
  
  x[
    is.na(x) |
      x == ""
  ] <- NA_character_
  
  x
}


# ============================================================
# 3.2 PADRONIZAR MARCADORES INFRAESPECÍFICOS
#
# Para comparação:
#
# ssp.    -> subsp.
# ssp     -> subsp.
# subsp   -> subsp.
# var     -> var.
# subvar  -> subvar.
# forma   -> f.
#
# Isso NÃO elimina o infraespecífico.
# ============================================================

padronizar_marcador_infra <- function(x) {
  
  if (
    is.na(x) ||
      trimws(x) == ""
  ) {
    return(NA_character_)
  }
  
  x <- as.character(x)
  
  x <- gsub(
    "\\bssp\\.?\\b",
    "subsp.",
    x,
    ignore.case = TRUE
  )
  
  x <- gsub(
    "\\bsubsp\\.?\\b",
    "subsp.",
    x,
    ignore.case = TRUE
  )
  
  x <- gsub(
    "\\bvar\\.?\\b",
    "var.",
    x,
    ignore.case = TRUE
  )
  
  x <- gsub(
    "\\bsubvar\\.?\\b",
    "subvar.",
    x,
    ignore.case = TRUE
  )
  
  x <- gsub(
    "\\bforma\\b",
    "f.",
    x,
    ignore.case = TRUE
  )
  
  x <- gsub(
    "\\bf\\.?\\b",
    "f.",
    x,
    ignore.case = TRUE
  )
  
  stringr::str_squish(x)
}


# ============================================================
# 3.3 PREPARAR NOME BOTÂNICO COMPLETO
#
# NOVO:
# NÃO remove var./subsp./f.
# ============================================================

preparar_nome_botanico_completo <- function(x) {
  
  if (
    is.na(x) ||
      trimws(x) == ""
  ) {
    return(NA_character_)
  }
  
  x <- as.character(x)
  
  x <- trimws(x)
  
  x <- gsub(
    "_",
    " ",
    x,
    fixed = TRUE
  )
  
  x <- gsub(
    "\u00A0",
    " ",
    x,
    fixed = TRUE
  )
  
  x <- stringr::str_squish(x)
  
  # × dumosus -> ×dumosus
  x <- gsub(
    "×[[:space:]]+",
    "×",
    x
  )
  
  # Padronizar marcador infraespecífico,
  # SEM eliminar o táxon infraespecífico
  x <- padronizar_marcador_infra(x)
  
  x <- stringr::str_squish(x)
  
  if (
    is.na(x) ||
      x == ""
  ) {
    return(NA_character_)
  }
  
  # Somente para apresentação:
  # primeira letra do gênero em maiúscula
  primeira <- toupper(
    substr(
      x,
      1,
      1
    )
  )
  
  restante <- substr(
    x,
    2,
    nchar(x)
  )
  
  paste0(
    primeira,
    restante
  )
}


# ============================================================
# 3.4 EXTRAIR PARTE INFRAESPECÍFICA
#
# Somente para registro.
# NÃO interfere na busca.
# ============================================================

extrair_infraespecifico <- function(x) {
  
  if (
    is.na(x) ||
      trimws(x) == ""
  ) {
    return(NA_character_)
  }
  
  x <- as.character(x)
  
  x <- gsub(
    "_",
    " ",
    x,
    fixed = TRUE
  )
  
  x <- stringr::str_squish(x)
  
  encontrado <- stringr::str_extract(
    x,
    regex(
      "\\b(subsp\\.?|ssp\\.?|var\\.?|subvar\\.?|f\\.?|forma)\\s+.*$",
      ignore_case = TRUE
    )
  )
  
  if (
    is.na(encontrado) ||
      trimws(encontrado) == ""
  ) {
    return(NA_character_)
  }
  
  trimws(encontrado)
}


# ============================================================
# 3.5 REDUZIR UM NOME AO NÍVEL DE ESPÉCIE
#
# IMPORTANTE:
# esta função será aplicada DEPOIS da conferência.
#
# Exemplos:
#
# Eugenia uniflora var. ...
# -> Eugenia uniflora
#
# Genus species subsp. alpha
# -> Genus species
#
# Phaseolus × dumosus
# -> Phaseolus ×dumosus
# ============================================================

reduzir_para_especie <- function(x) {
  
  if (
    is.na(x) ||
      trimws(x) == ""
  ) {
    return(NA_character_)
  }
  
  x <- as.character(x)
  
  x <- gsub(
    "_",
    " ",
    x,
    fixed = TRUE
  )
  
  x <- gsub(
    "\u00A0",
    " ",
    x,
    fixed = TRUE
  )
  
  x <- stringr::str_squish(x)
  
  # normalizar espaço após ×
  x <- gsub(
    "×[[:space:]]+",
    "×",
    x
  )
  
  # retirar autoria/infra usando estrutura do nome
  partes <- unlist(
    strsplit(
      x,
      "[[:space:]]+"
    )
  )
  
  if (length(partes) < 2) {
    return(x)
  }
  
  genero <- partes[1]
  
  segundo <- partes[2]
  
  # Caso:
  # Phaseolus × dumosus
  if (
    segundo == "×" &&
      length(partes) >= 3
  ) {
    
    return(
      paste(
        genero,
        paste0(
          "×",
          partes[3]
        )
      )
    )
  }
  
  # Caso:
  # Phaseolus ×dumosus
  if (
    grepl(
      "^×",
      segundo
    )
  ) {
    
    return(
      paste(
        genero,
        segundo
      )
    )
  }
  
  # Espécie normal
  paste(
    genero,
    segundo
  )
}


# ============================================================
# 3.6 IDENTIFICAR HÍBRIDO
# ============================================================

identificar_hibrido <- function(x) {
  
  if (
    is.na(x) ||
      trimws(x) == ""
  ) {
    return(FALSE)
  }
  
  grepl(
    "×",
    as.character(x),
    fixed = TRUE
  )
}


# ============================================================
# 3.7 EXTRAIR JSON REFLORA
# ============================================================

extrair_json <- function(x, campo) {
  
  if (
    is.na(x) ||
      trimws(x) == ""
  ) {
    return(NA_character_)
  }
  
  obj <- tryCatch(
    jsonlite::fromJSON(x),
    error = function(e) NULL
  )
  
  if (
    is.null(obj) ||
      is.null(obj[[campo]])
  ) {
    return(NA_character_)
  }
  
  valores <- unique(
    as.character(
      obj[[campo]]
    )
  )
  
  valores <- valores[
    !is.na(valores) &
      trimws(valores) != ""
  ]
  
  if (length(valores) == 0) {
    return(NA_character_)
  }
  
  paste(
    valores,
    collapse = "; "
  )
}


# ============================================================
# 3.8 JUNTAR VALORES ÚNICOS
# ============================================================

juntar_unicos <- function(x) {
  
  x <- as.character(x)
  
  x <- x[
    !is.na(x) &
      trimws(x) != ""
  ]
  
  x <- unique(x)
  
  if (length(x) == 0) {
    return(NA_character_)
  }
  
  paste(
    sort(x),
    collapse = "; "
  )
}


# ============================================================
# 3.9 LIFEFORM POWO
# ============================================================

extrair_lifeform_powo <- function(x) {
  
  x <- as.character(x)
  
  x_limpo <- gsub(
    '\\\\"',
    '"',
    x
  )
  
  x_limpo <- gsub(
    '"',
    '',
    x_limpo,
    fixed = TRUE
  )
  
  resultado <- stringr::str_match(
    x_limpo,
    "lifeform\\s*:\\s*([^,}]*)"
  )[, 2]
  
  resultado <- trimws(
    resultado
  )
  
  resultado[
    is.na(resultado) |
      resultado == ""
  ] <- NA_character_
  
  resultado
}


