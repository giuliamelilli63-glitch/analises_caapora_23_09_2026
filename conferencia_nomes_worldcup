    extrair_json,
    campo = "endemism",
    FUN.VALUE = character(1)
  )


distribution$dominio_fitogeografico <-
  vapply(
    distribution$occurrenceRemarks,
    extrair_json,
    campo = "phytogeographicDomain",
    FUN.VALUE = character(1)
  )


distribuicao_resumida <-
  distribution %>%
  
  group_by(
    id
  ) %>%
  
  summarise(
    
    establishmentMeans_reflora =
      juntar_unicos(
        establishmentMeans
      ),
    
    nativa_reflora =
      any(
        establishmentMeans ==
          "NATIVA",
        na.rm = TRUE
      ),
    
    naturalizada_reflora =
      any(
        establishmentMeans ==
          "NATURALIZADA",
        na.rm = TRUE
      ),
    
    cultivada_reflora =
      any(
        establishmentMeans ==
          "CULTIVADA",
        na.rm = TRUE
      ),
    
    endemismo_reflora =
      juntar_unicos(
        endemismo
      ),
    
    dominio_fitogeografico_reflora =
      juntar_unicos(
        dominio_fitogeografico
      ),
    
    estados_reflora =
      juntar_unicos(
        locationID
      ),
    
    .groups =
      "drop"
  )


taxon$id_aceito_reflora <-
  as.character(
    id_aceito_reflora
  )


taxon <- taxon %>%
  
  left_join(
    
    distribuicao_resumida %>%
      
      rename(
        id_aceito_reflora =
          id
      ),
    
    by =
      "id_aceito_reflora"
  )


# ============================================================
# 17. PRIORIDADE REFLORA
# ============================================================

taxon$prioridade_reflora <-
  case_when(
    
    taxon$status_padronizado ==
      "NOME_ACEITO" ~
      1L,
    
    taxon$status_padronizado ==
      "SINONIMO" ~
      2L,
    
    TRUE ~
      3L
  )


taxon_ordenado <- taxon[
  order(
    taxon$chave_completa_reflora,
    taxon$prioridade_reflora
  ),
  ,
  drop = FALSE
]


# ============================================================
# 18. LOOKUP REFLORA
# ============================================================

lookup_reflora <- taxon_ordenado[
  !is.na(
    taxon_ordenado$chave_completa_reflora
  ) &
    !duplicated(
      taxon_ordenado$chave_completa_reflora
    ),
  ,
  drop = FALSE
]


# ============================================================
# 19. CONFERIR NO REFLORA
#
# AGORA:
# chave completa × chave completa
# ============================================================

posicao_reflora <- match(
  especies$chave_busca_completa,
  lookup_reflora$chave_completa_reflora
)


especies$conferencia_reflora <-
  !is.na(
    especies$chave_busca_completa
  ) &
  !is.na(
    posicao_reflora
  )


# ============================================================
# 20. FUNÇÃO EXTRAÇÃO REFLORA
# ============================================================

extrair_reflora <- function(coluna) {
  
  resultado <-
    rep(
      NA,
      nrow(especies)
    )
  
  indices <- which(
    especies$conferencia_reflora
  )
  
  resultado[
    indices
  ] <-
    coluna[
      posicao_reflora[
        indices
      ]
    ]
  
  resultado
}


# ============================================================
# 21. RESULTADOS REFLORA
# ============================================================

especies$taxonID_reflora <-
  extrair_reflora(
    lookup_reflora$taxonID
  )

especies$taxonID_aceito_reflora <-
  extrair_reflora(
    lookup_reflora$taxonID_aceito
  )

especies$nome_encontrado_reflora <-
  extrair_reflora(
    lookup_reflora$scientificName
  )

especies$nome_aceito_reflora <-
  extrair_reflora(
    lookup_reflora$nome_aceito_reflora
  )

especies$nome_aceito_completo_sem_autoria_reflora <-
  extrair_reflora(
    lookup_reflora$
      nome_aceito_completo_sem_autoria_reflora
  )

especies$familia_reflora <-
  extrair_reflora(
    lookup_reflora$familia_aceita_reflora
  )

especies$genero_reflora <-
  extrair_reflora(
    lookup_reflora$genero_aceito_reflora
  )

especies$nivel_taxonomico_reflora <-
  extrair_reflora(
    lookup_reflora$rank_aceito_reflora
  )

especies$autoria_reflora <-
  extrair_reflora(
    lookup_reflora$scientificNameAuthorship
  )

especies$status_taxonomico_reflora <-
  extrair_reflora(
    lookup_reflora$status_padronizado
  )

especies$status_nomenclatural_reflora <-
  extrair_reflora(
    lookup_reflora$
      status_nomenclatural_aceito_reflora
  )

especies$relacao_nome_aceito_reflora <-
  extrair_reflora(
    lookup_reflora$relacao_nome_aceito
  )

especies$lifeForm_reflora <-
  extrair_reflora(
    lookup_reflora$lifeForm_reflora
  )

especies$establishmentMeans_reflora <-
  extrair_reflora(
    lookup_reflora$establishmentMeans_reflora
  )

especies$nativa_reflora <-
  extrair_reflora(
    lookup_reflora$nativa_reflora
  )

especies$naturalizada_reflora <-
  extrair_reflora(
    lookup_reflora$naturalizada_reflora
  )

especies$cultivada_reflora <-
  extrair_reflora(
    lookup_reflora$cultivada_reflora
  )

especies$endemismo_reflora <-
  extrair_reflora(
    lookup_reflora$endemismo_reflora
  )

especies$dominio_fitogeografico_reflora <-
  extrair_reflora(
    lookup_reflora$
      dominio_fitogeografico_reflora
  )

especies$estados_reflora <-
  extrair_reflora(
    lookup_reflora$estados_reflora
  )


# ============================================================
# PARTE II — POWO / WCVP
# ============================================================


# ============================================================
# 22. LER WCVP
# ============================================================

cat("\n============================================\n")
cat("LENDO POWO / WCVP\n")
cat("============================================\n\n")


wcvp <- read.delim(
  arquivo_wcvp_taxon,
  sep = "|",
  header = TRUE,
  quote = "",
  stringsAsFactors = FALSE,
  check.names = FALSE,
  fileEncoding = "UTF-8",
  fill = TRUE
)


names(wcvp) <-
  tolower(
    trimws(
      names(wcvp)
    )
  )


# ============================================================
# 23. IDENTIFICAR COLUNAS WCVP
# ============================================================

if ("scientfiicname" %in% names(wcvp)) {
  
  coluna_nome_wcvp <-
    "scientfiicname"
  
} else if ("scientificname" %in% names(wcvp)) {
  
  coluna_nome_wcvp <-
    "scientificname"
  
} else {
  
  stop(
    "Não encontrei scientificname/scientfiicname no WCVP."
  )
}


if (
  "scientfiicnameauthorship" %in%
    names(wcvp)
) {
  
  coluna_autoria_wcvp <-
    "scientfiicnameauthorship"
  
} else if (
  "scientificnameauthorship" %in%
    names(wcvp)
) {
  
  coluna_autoria_wcvp <-
    "scientificnameauthorship"
  
} else {
  
  stop(
    "Não encontrei a coluna de autoria no WCVP."
  )
}


# ============================================================
# 24. PREPARAR WCVP
# ============================================================

wcvp$nome_cientifico_wcvp <-
  wcvp[[coluna_nome_wcvp]]

wcvp$autoria_wcvp <-
  wcvp[[coluna_autoria_wcvp]]

wcvp$taxonid <-
  as.character(
    wcvp$taxonid
  )

wcvp$acceptednameusageid <-
  as.character(
    wcvp$acceptednameusageid
  )


# ------------------------------------------------------------
# NOME COMPLETO PARA BUSCA
#
# Preservamos infraespecífico.
# ------------------------------------------------------------

wcvp$nome_completo_busca_powo <-
  vapply(
    wcvp$nome_cientifico_wcvp,
    padronizar_marcador_infra,
    FUN.VALUE = character(1)
  )


wcvp$chave_powo <-
  normalizar_nome(
    wcvp$nome_completo_busca_powo
  )


wcvp$lifeform_powo <-
  extrair_lifeform_powo(
    wcvp$dynamicproperties
  )


cat(
  "Registros no WCVP:",
  nrow(wcvp),
  "\n"
)


# ============================================================
# 25. TÁXONS POWO QUE PODEM SER USADOS COMO NOME FINAL
# ============================================================
#
# IMPORTANTE:
#
# Accepted / Provisionally Accepted:
#   o próprio táxon é o nome aceito.
#
# Artificial Hybrid:
#   será MANTIDO na nossa base.
#   Não estamos dizendo que seu status é "Accepted".
#   Seu status continua sendo "Artificial Hybrid".
#
# Synonym:
#   será posteriormente ligado ao nome aceito.
# ============================================================


wcvp_nomes_finais <- wcvp %>%
  
  filter(
    taxonomicstatus %in%
      c(
        "Accepted",
        "Provisionally Accepted",
        "Artificial Hybrid"
      )
  ) %>%
  
  transmute(
    
    taxonid_nome_final_powo =
      taxonid,
    
    nome_final_powo =
      nome_cientifico_wcvp,
    
    autoria_final_powo =
      autoria_wcvp,
    
    familia_final_powo =
      family,
    
    genero_final_powo =
      genus,
    
    rank_final_powo =
      taxonrank,
    
    status_nome_final_powo =
      taxonomicstatus,
    
    lifeform_final_powo =
      lifeform_powo
  )


# ============================================================
# 26. ENVIAR AO POWO SOMENTE NÃO ENCONTRADOS NO REFLORA
# ============================================================

busca_powo <- especies %>%
  
  filter(
    !conferencia_reflora,
    !is.na(
      chave_busca_completa
    )
  ) %>%
  
  distinct(
    chave_busca_completa,
    .keep_all = TRUE
  ) %>%
  
  transmute(
    chave_powo =
      chave_busca_completa
  )


cat(
  "Nomes enviados ao POWO:",
  nrow(busca_powo),
  "\n"
)


# ============================================================
# 27. CORRESPONDÊNCIAS POWO
# ============================================================

correspondencias_powo <- busca_powo %>%
  
  left_join(
    
    wcvp %>%
      
      select(
        
        chave_powo,
        
        taxonid_powo =
          taxonid,
        
        nome_encontrado_powo =
          nome_cientifico_wcvp,
        
        autoria_encontrada_powo =
          autoria_wcvp,
        
        status_powo =
          taxonomicstatus,
        
        acceptednameusageid,
        
        familia_nome_encontrado_powo =
          family,
        
        genero_nome_encontrado_powo =
          genus,
        
        rank_nome_encontrado_powo =
          taxonrank,
        
        lifeform_nome_encontrado_powo =
          lifeform_powo
      ),
    
    by =
      "chave_powo",
    
    relationship =
      "many-to-many"
  ) %>%
  
  mutate(
    
    encontrado_powo =
      !is.na(
        taxonid_powo
      ),
    
    
    # --------------------------------------------------------
    # PRIORIDADE
    #
    # 1 = nome aceito
    # 2 = sinônimo, porque conseguimos recuperar aceito
    # 3 = híbrido artificial, que será mantido
    # 4 = outro status encontrado
    # 5 = não encontrado
    # --------------------------------------------------------
    
    prioridade_powo =
      case_when(
        
        status_powo %in%
          c(
            "Accepted",
            "Provisionally Accepted"
          ) ~
          1L,
        
        status_powo ==
          "Synonym" ~
          2L,
        
        status_powo ==
          "Artificial Hybrid" ~
          3L,
        
        encontrado_powo ~
          4L,
        
        TRUE ~
          5L
      )
  )


# ============================================================
# 28. MELHOR PRIORIDADE POWO
# ============================================================

melhor_powo <- correspondencias_powo %>%
  
  group_by(
    chave_powo
  ) %>%
  
  mutate(
    
    melhor_prioridade =
      min(
        prioridade_powo,
        na.rm = TRUE
      )
  ) %>%
  
  filter(
    prioridade_powo ==
      melhor_prioridade
  ) %>%
  
  ungroup()


# ============================================================
# 29. IDENTIFICAR EMPATES REAIS
# ============================================================

empates_powo <- melhor_powo %>%
  
  filter(
    encontrado_powo
  ) %>%
  
  group_by(
    chave_powo
  ) %>%
  
  summarise(
    
    n_taxons =
      n_distinct(
        taxonid_powo
      ),
    
    .groups =
      "drop"
  ) %>%
  
  filter(
    n_taxons > 1
  )


chaves_empate <-
  empates_powo$chave_powo


# ============================================================
# 30. RESULTADOS SEM EMPATE
# ============================================================

selecionados_powo <- melhor_powo %>%
  
  filter(
    !chave_powo %in%
      chaves_empate
  ) %>%
  
  group_by(
    chave_powo
  ) %>%
  
  slice(1) %>%
  
  ungroup() %>%
  
  mutate(
    
    decisao_powo =
      case_when(
        
        !encontrado_powo ~
          "NAO_ENCONTRADO",
        
        status_powo %in%
          c(
            "Accepted",
            "Provisionally Accepted"
          ) ~
          "ACCEPTED",
        
        status_powo ==
          "Synonym" ~
          "SYNONYM",
        
        status_powo ==
          "Artificial Hybrid" ~
          "ARTIFICIAL_HYBRID",
        
        TRUE ~
          "REVISAR_STATUS"
      ),
    
    
    # --------------------------------------------------------
    # ID DO NOME FINAL
    #
    # Accepted:
    #   próprio taxonID
    #
    # Synonym:
    #   acceptedNameUsageID
    #
    # Artificial Hybrid:
    #   próprio taxonID
    # --------------------------------------------------------
    
    taxonid_nome_final_powo =
      case_when(
        
        decisao_powo ==
          "ACCEPTED" ~
          taxonid_powo,
        
        decisao_powo ==
          "SYNONYM" ~
          acceptednameusageid,
        
        decisao_powo ==
          "ARTIFICIAL_HYBRID" ~
          taxonid_powo,
        
        TRUE ~
          NA_character_
      )
  )


# ============================================================
# 31. RECUPERAR NOME FINAL POWO
# ============================================================

selecionados_powo <- selecionados_powo %>%
  
  left_join(
    
    wcvp_nomes_finais,
    
    by =
      "taxonid_nome_final_powo"
  )


# ============================================================
# 32. GARANTIA ESPECIAL PARA ARTIFICIAL HYBRID
#
# Mesmo que, por algum motivo, o join anterior não recupere
# alguma informação, o híbrido artificial recebe os dados
# do próprio registro encontrado.
# ============================================================

selecionados_powo <- selecionados_powo %>%
  
  mutate(
    
    nome_final_powo =
      case_when(
        
        decisao_powo ==
          "ARTIFICIAL_HYBRID" &
          is.na(nome_final_powo) ~
          nome_encontrado_powo,
        
        TRUE ~
          nome_final_powo
      ),
    
    
    autoria_final_powo =
      case_when(
        
        decisao_powo ==
          "ARTIFICIAL_HYBRID" &
          is.na(autoria_final_powo) ~
          autoria_encontrada_powo,
        
        TRUE ~
          autoria_final_powo
      ),
    
    
    familia_final_powo =
      case_when(
        
        decisao_powo ==
          "ARTIFICIAL_HYBRID" &
          is.na(familia_final_powo) ~
          familia_nome_encontrado_powo,
        
        TRUE ~
          familia_final_powo
      ),
    
    
    genero_final_powo =
      case_when(
        
        decisao_powo ==
          "ARTIFICIAL_HYBRID" &
          is.na(genero_final_powo) ~
          genero_nome_encontrado_powo,
        
        TRUE ~
          genero_final_powo
      ),
    
    
    rank_final_powo =
      case_when(
        
        decisao_powo ==
          "ARTIFICIAL_HYBRID" &
          is.na(rank_final_powo) ~
          rank_nome_encontrado_powo,
        
        TRUE ~
          rank_final_powo
      ),
    
    
    lifeform_final_powo =
      case_when(
        
        decisao_powo ==
          "ARTIFICIAL_HYBRID" &
          is.na(lifeform_final_powo) ~
          lifeform_nome_encontrado_powo,
        
        TRUE ~
          lifeform_final_powo
      ),
    
    
    status_nome_final_powo =
      case_when(
        
        decisao_powo ==
          "ARTIFICIAL_HYBRID" ~
          "Artificial Hybrid",
        
        TRUE ~
          status_nome_final_powo
      )
  )


# ============================================================
# 33. PREPARAR RESULTADOS POWO
# ============================================================

dados_powo <- selecionados_powo %>%
  
  select(
    
    chave_powo,
    
    encontrado_powo,
    
    decisao_powo,
    
    taxonid_powo,
    
    nome_encontrado_powo,
    
    autoria_encontrada_powo,
    
    status_powo,
    
    acceptednameusageid,
    
    taxonid_nome_final_powo,
    
    nome_final_powo,
    
    autoria_final_powo,
    
    familia_final_powo,
    
    genero_final_powo,
    
    rank_final_powo,
    
    status_nome_final_powo,
    
    lifeform_final_powo
  )


# ============================================================
# 34. DEVOLVER POWO PARA TABELA
# ============================================================

especies <- especies %>%
  
  left_join(
    
    dados_powo,
    
    by =
      c(
        "chave_busca_completa" =
          "chave_powo"
      )
  )


# ============================================================
# 35. MARCAR EMPATES POWO
# ============================================================

especies$empate_powo <-
  especies$chave_busca_completa %in%
  chaves_empate


# ============================================================
# 36. RESULTADO FINAL DA CONFERÊNCIA
# ============================================================

especies <- especies %>%
  
  mutate(
    
    # --------------------------------------------------------
    # BASE QUE RESOLVEU O NOME
    # --------------------------------------------------------
    
    base_conferencia =
      case_when(
        
        conferencia_reflora ~
          "REFLORA",
        
        !is.na(decisao_powo) &
          decisao_powo %in%
          c(
            "ACCEPTED",
            "SYNONYM",
            "ARTIFICIAL_HYBRID"
          ) ~
          "POWO",
        
        TRUE ~
          NA_character_
      ),
    
    
    # --------------------------------------------------------
    # STATUS DA NOSSA CONFERÊNCIA
    # --------------------------------------------------------
    
    status_conferencia =
      case_when(
        
        conferencia_reflora ~
          "CONFERIDO_REFLORA",
        
        empate_powo ~
          "EMPATE_POWO_REVISAR",
        
        decisao_powo ==
          "ACCEPTED" ~
          "CONFERIDO_POWO",
        
        decisao_powo ==
          "SYNONYM" ~
          "CONFERIDO_POWO_SINONIMO",
        
        decisao_powo ==
          "ARTIFICIAL_HYBRID" ~
          "CONFERIDO_POWO_HIBRIDO_ARTIFICIAL",
        
        decisao_powo ==
          "REVISAR_STATUS" ~
          "REVISAR_STATUS_POWO",
        
        TRUE ~
          "NAO_ENCONTRADO"
      )
  )


# ============================================================
# 37. CRIAR O NOME ACEITO FINAL
#
# ESTA É A COLUNA QUE SERÁ USADA POSTERIORMENTE.
# ============================================================

especies <- especies %>%
  
  mutate(
    
    # --------------------------------------------------------
    # NOME COMPLETO SEM AUTORIA
    #
    # Accepted -> nome aceito
    # Synonym  -> nome aceito recuperado
    # Artificial Hybrid -> próprio nome híbrido
    # --------------------------------------------------------
    
    nome_aceito_final_sem_autoria =
      case_when(
        
        conferencia_reflora ~
          nome_aceito_completo_sem_autoria_reflora,
        
        base_conferencia ==
          "POWO" ~
          nome_final_powo,
        
        TRUE ~
          NA_character_
      ),
    
    
    # --------------------------------------------------------
    # NOME ACEITO FINAL COM AUTORIA
    #
    # ESTA É A COLUNA PRINCIPAL FINAL.
    # --------------------------------------------------------
    
    nome_aceito_final =
      case_when(
        
        # REFLORA já fornece scientificName
        # com o nome final correspondente
        conferencia_reflora ~
          nome_aceito_reflora,
        
        
        # POWO
        base_conferencia ==
          "POWO" &
          (
            is.na(autoria_final_powo) |
              trimws(
                autoria_final_powo
              ) == ""
          ) ~
          nome_final_powo,
        
        
        base_conferencia ==
          "POWO" ~
          paste(
            nome_final_powo,
            autoria_final_powo
          ),
        
        
        TRUE ~
          NA_character_
      ),
    
    
    # --------------------------------------------------------
    # FAMÍLIA FINAL
    # --------------------------------------------------------
    
    familia_final =
      case_when(
        
        conferencia_reflora ~
          familia_reflora,
        
        base_conferencia ==
          "POWO" ~
          familia_final_powo,
        
        TRUE ~
          NA_character_
      ),
    
    
    # --------------------------------------------------------
    # GÊNERO FINAL
    # --------------------------------------------------------
    
    genero_final =
      case_when(
        
        conferencia_reflora ~
          genero_reflora,
        
        base_conferencia ==
          "POWO" ~
          genero_final_powo,
        
        TRUE ~
          NA_character_
      ),
    
    
    # --------------------------------------------------------
    # NÍVEL TAXONÔMICO FINAL
    # --------------------------------------------------------
    
    nivel_taxonomico_final =
      case_when(
        
        conferencia_reflora ~
          nivel_taxonomico_reflora,
        
        base_conferencia ==
          "POWO" ~
          rank_final_powo,
        
        TRUE ~
          NA_character_
      ),
    
    
    # --------------------------------------------------------
    # STATUS TAXONÔMICO FINAL
    #
    # Importante:
    # Artificial Hybrid continua Artificial Hybrid.
    # --------------------------------------------------------
    
    status_taxonomico_final =
      case_when(
        
        conferencia_reflora ~
          status_taxonomico_reflora,
        
        base_conferencia ==
          "POWO" ~
          status_nome_final_powo,
        
        TRUE ~
          NA_character_
      ),
    
    
    # --------------------------------------------------------
    # LIFE FORM FINAL
    # --------------------------------------------------------
    
    lifeForm_final =
      case_when(
        
        conferencia_reflora ~
          lifeForm_reflora,
        
        base_conferencia ==
          "POWO" ~
          lifeform_final_powo,
        
        TRUE ~
          NA_character_
      )
  )


# ============================================================
# 38. REDUZIR AO NÍVEL DE ESPÉCIE
#
# SOMENTE DEPOIS DA CONFERÊNCIA.
# ============================================================

especies$nome_aceito_especie <-
  vapply(
    especies$nome_aceito_final_sem_autoria,
    reduzir_para_especie,
    FUN.VALUE = character(1)
  )


# ============================================================
# 39. CHAVE FINAL PARA FUTURA CONSOLIDAÇÃO
#
# Esta será especialmente importante quando juntarmos:
#
# Gustavo
# Mansfeld
# WorldCuP
# ============================================================

especies$chave_nome_aceito_especie <-
  normalizar_nome(
    especies$nome_aceito_especie
  )


# ============================================================
# 40. DECISÃO DE PERMANÊNCIA NA BASE
# ============================================================

especies <- especies %>%
  
  mutate(
    
    decisao_base_final =
      case_when(
        
        status_conferencia %in%
          c(
            "CONFERIDO_REFLORA",
            "CONFERIDO_POWO",
            "CONFERIDO_POWO_SINONIMO",
            "CONFERIDO_POWO_HIBRIDO_ARTIFICIAL"
          ) ~
          "MANTER",
        
        status_conferencia %in%
          c(
            "EMPATE_POWO_REVISAR",
            "REVISAR_STATUS_POWO"
          ) ~
          "REVISAR",
        
        TRUE ~
          "NAO_RESOLVIDO"
      )
  )


# ============================================================
# 41. TESTE CRÍTICO DOS HÍBRIDOS ARTIFICIAIS
# ============================================================

teste_hibridos_artificiais <- especies %>%
  
  filter(
    hibrido_artificial_worldcup == TRUE
  ) %>%
  
  select(
    
    especie,
    
    taxon_author_acc,
    
    taxon_status_acc,
    
    nome_corrigido_completo,
    
    conferencia_reflora,
    
    decisao_powo,
    
    status_powo,
    
    status_conferencia,
    
    nome_aceito_final_sem_autoria,
    
    nome_aceito_final,
    
    nome_aceito_especie,
    
    status_taxonomico_final,
    
    decisao_base_final
  )


cat("\n============================================\n")
cat("HÍBRIDOS ARTIFICIAIS\n")
cat("============================================\n\n")

print(
  teste_hibridos_artificiais,
  n = Inf
)


# ============================================================
# 42. TESTE: HÍBRIDO ARTIFICIAL CONFERIDO NÃO PODE
#     FICAR SEM NOME FINAL
# ============================================================

problema_hibrido <- especies %>%
  
  filter(
    
    status_conferencia ==
      "CONFERIDO_POWO_HIBRIDO_ARTIFICIAL",
    
    is.na(nome_aceito_final) |
      trimws(nome_aceito_final) == ""
  )


if (nrow(problema_hibrido) > 0) {
  
  stop(
    paste0(
      "ERRO: ",
      nrow(problema_hibrido),
      " híbrido(s) artificial(is) foram conferidos ",
      "mas ficaram sem nome_aceito_final."
    )
  )
}


# ============================================================
# 43. TESTE: QUALQUER REGISTRO MARCADO COMO MANTER
#     PRECISA TER NOME ACEITO FINAL
# ============================================================

problema_nome_final <- especies %>%
  
  filter(
    
    decisao_base_final ==
      "MANTER",
    
    is.na(nome_aceito_final) |
      trimws(nome_aceito_final) == ""
  )


if (nrow(problema_nome_final) > 0) {
  
  stop(
    paste0(
      "ERRO: ",
      nrow(problema_nome_final),
      " registro(s) marcados como MANTER ",
      "estão sem nome_aceito_final."
    )
  )
}


# ============================================================
# 44. RESUMO
# ============================================================

resumo <- especies %>%
  
  count(
    status_conferencia,
    decisao_base_final,
    name =
      "numero_registros"
  ) %>%
  
  arrange(
    desc(
      numero_registros
    )
  )


cat("\n============================================\n")
cat("RESUMO DA CONFERÊNCIA\n")
